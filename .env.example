# Okdesk CRM Telegram Bot - Environment Configuration
# Скопируйте этот файл в .env и заполните значения

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Okdesk API Token (из настроек аккаунта Okdesk)
OKDESK_API_TOKEN=your_okdesk_api_token_here

# Базовый URL вашего аккаунта Okdesk
OKDESK_BASE_URL=https://your-domain.okdesk.ru

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=okypbot
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Webhook настройки
WEBHOOK_ENABLED=true
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_URL=https://your-domain.okdesk.ru/okdesk-webhook

# Секретный ключ для подписи webhook'ов (придумайте любой сложный ключ)
OKDESK_WEBHOOK_SECRET=your_webhook_secret_key

# Список ID администраторов (через запятую)
ADMIN_IDS=123456789,987654321

# Режим разработки (false для production)
DEBUG=false

# Логирование
LOG_LEVEL=INFO
