# Конфигурация бота - пример файла
# Скопируйте этот файл в config.py и заполните своими значениями

# Telegram Bot Token
# Получить можно у @BotFather в Telegram
BOT_TOKEN = "your_telegram_bot_token_here"

# Okdesk API Configuration
# Токен API можно получить в настройках Okdesk
OKDESK_API_TOKEN = "your_okdesk_api_token_here"

# Базовый URL вашего Okdesk
# Например: https://yourcompany.okdesk.ru
OKDESK_BASE_URL = "https://yourcompany.okdesk.ru"

# Настройки логирования
LOG_LEVEL = "INFO"  # DEBUG, INFO, WARNING, ERROR
LOG_FILE = "bot.log"

# Настройки мониторинга заявок
MONITOR_INTERVAL = 30  # секунд между проверками
MONITOR_ENABLED = True

# Максимальная длина текста заявки
MAX_ISSUE_TEXT_LENGTH = 4000

# Таймауты для HTTP запросов (секунды)
HTTP_TIMEOUT = 30

# Настройки базы данных
DATABASE_FILE = "database/users.json"

# Валидация
MIN_PHONE_LENGTH = 10
MAX_PHONE_LENGTH = 15
MIN_NAME_LENGTH = 2
MAX_NAME_LENGTH = 50

# Поддерживаемые форматы ИНН
INN_LENGTH_INDIVIDUAL = 12  # Для физ. лиц
INN_LENGTH_LEGAL = 10       # Для юр. лиц
