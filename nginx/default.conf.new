server {
    listen 80;
    server_name _;

    # Simple health check
    location /health {
        proxy_pass http://bot:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # Forward webhook requests to bot
    location /okdesk-webhook {
        proxy_pass http://bot:8000/okdesk-webhook;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;  # Увеличиваем таймаут для обработки длинных запросов
        client_max_body_size 10M;  # Разрешаем большие запросы
    }

    # Root response
    location / {
        proxy_pass http://bot:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
